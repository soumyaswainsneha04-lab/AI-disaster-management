# Disaster AI India backend environment template
# Copy the values into your local environment; DO NOT commit a real .env file.

# JWT signing secret. Use a long random value. If omitted, the app creates
# data/operations_state/.jwt_secret locally.
DISASTER_AI_SECRET_KEY=replace-with-a-long-random-secret
DISASTER_AI_TOKEN_HOURS=8

# Only needed when creating a brand-new empty database.
# Your existing demo database already contains the seeded users, so you do
# not need to set these just to continue using the current project.
DISASTER_AI_ADMIN_PASSWORD=replace-with-your-admin-password
DISASTER_AI_COORDINATOR_PASSWORD=replace-with-your-coordinator-password
DISASTER_AI_FIELD_PASSWORD=replace-with-your-field-password

# Login throttling (defaults are suitable for the academic prototype).
DISASTER_AI_LOGIN_MAX_FAILURES=6
DISASTER_AI_LOGIN_WINDOW_SECONDS=300

# Optional: set to false for a stricter deployment that should not accept
# direct browser origins from private LAN addresses.
DISASTER_AI_ALLOW_LAN_ORIGINS=true
